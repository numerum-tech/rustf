//! {{title}} CRUD controller.
//!
//! HTTP LAYER ONLY. Per RustF's layering rule
//! (Base Model -> Model -> Module -> Controller), this file contains ZERO
//! calls to `{{pascal_name}}::*` or any other model. All business
//! logic, validation, and model access live in
//! `crate::modules::{{name}}_service`. If you find yourself reaching for
//! `use crate::models::*` here, push that code into the service instead.
//!
//! VIEW DATA — two channels, don't mix them up:
//!   * `ctx.view(tpl, model)` -> `@{M...}`. ONE simple object: the record or
//!     form the page is about. A list page has no model; pass `json!({})`.
//!   * `ctx.repository_set(k, v)` -> `@{R.k}`. Everything else: title, csrf,
//!     collections, nav, counters. Set each key as the data becomes
//!     available — never assemble one big `json!` and dump it into the model.

use crate::modules::{{name}}_service::{{pascal_name}}Service;
use rustf::prelude::*;

pub fn install() -> Vec<Route> {
    routes![
        GET    "/{{name}}"           => index,
        GET    "/{{name}}/new"       => new_form,
        POST   "/{{name}}"           => create,
        GET    "/{{name}}/{id}"       => show,
        GET    "/{{name}}/{id}/edit"  => edit_form,
        PUT    "/{{name}}/{id}"       => update,
        DELETE "/{{name}}/{id}"       => destroy,
    ]
}

async fn index(ctx: &mut Context) -> rustf::Result<()> {
    // R: push each piece as it becomes available.
    ctx.repository_set("title", "{{title}}");

    let items = {{pascal_name}}Service::list_all().await?;
    ctx.repository_set("items", serde_json::to_value(&items)?);

    // M: a list page has no single subject. View iterates `@{R.items}`.
    ctx.view("{{name}}/index", json!({}))
}

async fn show(ctx: &mut Context) -> rustf::Result<()> {
    let id = ctx.param_int("id")? as i64;
    match {{pascal_name}}Service::find(id).await? {
        Some(item) => {
            let csrf = ctx.generate_csrf(None)?;
            ctx.repository_set("title", format!("{{title_singular}} #{}", id));
            ctx.repository_set("csrf_token", csrf);

            // M: the record this page is about -> `@{M.field}`.
            ctx.view("{{name}}/show", serde_json::to_value(&item)?)
        }
        None => ctx.throw404(Some("{{title_singular}} not found")),
    }
}

async fn new_form(ctx: &mut Context) -> rustf::Result<()> {
    let csrf = ctx.generate_csrf(None)?;
    ctx.repository_set("title", "New {{title_singular}}");
    ctx.repository_set("csrf_token", csrf);

    // M: empty form — no record yet.
    ctx.view("{{name}}/new", json!({}))
}

async fn create(ctx: &mut Context) -> rustf::Result<()> {
    let form = ctx.body_form()?;
    match {{pascal_name}}Service::create(&form).await {
        Ok(id) => {
            ctx.flash_success("{{title_singular}} created.")?;
            ctx.redirect(&format!("/{{name}}/{}", id))
        }
        Err(e) => {
            ctx.flash_error(&format!("Create failed: {}", e))?;
            ctx.redirect("/{{name}}/new")
        }
    }
}

async fn edit_form(ctx: &mut Context) -> rustf::Result<()> {
    let id = ctx.param_int("id")? as i64;
    match {{pascal_name}}Service::find(id).await? {
        Some(item) => {
            let csrf = ctx.generate_csrf(None)?;
            ctx.repository_set("title", format!("Edit {{title_singular}} #{}", id));
            ctx.repository_set("csrf_token", csrf);

            // M: the record being edited — the form binds to `@{M.field}`.
            ctx.view("{{name}}/edit", serde_json::to_value(&item)?)
        }
        None => ctx.throw404(Some("{{title_singular}} not found")),
    }
}

async fn update(ctx: &mut Context) -> rustf::Result<()> {
    let id = ctx.param_int("id")? as i64;
    let form = ctx.body_form()?;
    match {{pascal_name}}Service::update(id, &form).await {
        Ok(()) => {
            ctx.flash_success("{{title_singular}} updated.")?;
            ctx.redirect(&format!("/{{name}}/{}", id))
        }
        Err(e) => {
            ctx.flash_error(&format!("Update failed: {}", e))?;
            ctx.redirect(&format!("/{{name}}/{}/edit", id))
        }
    }
}

async fn destroy(ctx: &mut Context) -> rustf::Result<()> {
    let id = ctx.param_int("id")? as i64;
    {{pascal_name}}Service::delete(id).await?;
    ctx.flash_success("{{title_singular}} deleted.")?;
    ctx.redirect("/{{name}}")
}
