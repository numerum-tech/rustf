use once_cell::sync::Lazy;
use serde::{Deserialize, Serialize};
use std::sync::Mutex;

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct {{pascal_name_singular}} {
    pub id: i64,
    pub name: String,
}

static STORE: Lazy<Mutex<Vec<{{pascal_name_singular}}>>> = Lazy::new(|| Mutex::new(Vec::new()));
static NEXT_ID: Lazy<Mutex<i64>> = Lazy::new(|| Mutex::new(1));

impl {{pascal_name_singular}} {
    pub fn all() -> Vec<Self> {
        STORE.lock().unwrap().clone()
    }

    pub fn find(id: i64) -> Option<Self> {
        STORE.lock().unwrap().iter().find(|x| x.id == id).cloned()
    }

    pub fn create(name: String) -> Self {
        let mut next = NEXT_ID.lock().unwrap();
        let id = *next;
        *next += 1;
        let item = Self { id, name };
        STORE.lock().unwrap().push(item.clone());
        item
    }

    pub fn update(id: i64, name: String) -> Option<Self> {
        let mut store = STORE.lock().unwrap();
        if let Some(item) = store.iter_mut().find(|x| x.id == id) {
            item.name = name;
            return Some(item.clone());
        }
        None
    }

    pub fn delete(id: i64) -> bool {
        let mut store = STORE.lock().unwrap();
        let before = store.len();
        store.retain(|x| x.id != id);
        store.len() < before
    }
}

