//! {{name}} definition module
//!
//! Customises framework behaviour through the definitions system:
//! template helpers, validators, and the session-storage factory.
//!
//! NOTE: The definitions system today is intentionally small. It covers
//! HELPERS (template functions) and VALIDATORS (reusable validation rules),
//! plus a SessionStorageFactory hook. It does NOT include a generic
//! "interceptor" or "provider" system — those are framework features in
//! other subsystems (middleware, events, shared modules). Don't bolt new
//! categories onto Definitions; use the subsystem built for the job.

use rustf::definitions::{Definitions, Helper, Validator};
use rustf::prelude::*;
use serde_json::Value;

/// Install function called by auto-discovery.
///
/// `auto_definitions!()` finds this and calls it at startup.
pub fn install(defs: &mut Definitions) {
    register_helpers(defs);
    register_validators(defs);

    // Uncomment if you're supplying a custom session storage backend:
    // defs.set_session_storage_factory(my_session_factory);
}

/// Register template helpers (callable from views as `@{my_helper(x)}`).
fn register_helpers(defs: &mut Definitions) {
    // Struct-based helper — implements the `Helper` trait below.
    defs.register_helper("{{name}}_format", CustomFormatHelper);

    // Closure-based helper — goes through HelperRegistry::register_fn,
    // which takes (name, description, closure). The description is used
    // for diagnostics / future docs tooling.
    defs.helpers.register_fn(
        "{{name}}_helper",
        "Example {{name}} helper returning its first argument",
        |args, _ctx| {
            Ok(args.first().cloned().unwrap_or(Value::Null))
        },
    );
}

/// Register validators (callable from models / forms by name).
fn register_validators(defs: &mut Definitions) {
    defs.register_validator("{{name}}_validator", CustomValidator);

    // Closure-based validator via ValidatorRegistry::register_fn.
    defs.validators.register_fn(
        "{{name}}_check",
        "Reject null values",
        |value, _options| {
            if value.is_null() {
                return Err(rustf::Error::validation("Value cannot be null"));
            }
            Ok(())
        },
    );
}

/// Custom helper implementation.
struct CustomFormatHelper;

impl Helper for CustomFormatHelper {
    fn call(&self, args: &[Value], _context: Option<&Value>) -> rustf::Result<Value> {
        // Replace with your real formatting logic.
        Ok(args.first().cloned().unwrap_or(Value::Null))
    }

    fn name(&self) -> &str {
        "{{name}}_format"
    }

    fn description(&self) -> &str {
        "Format values for the {{name}} feature"
    }
}

/// Custom validator implementation.
struct CustomValidator;

impl Validator for CustomValidator {
    fn validate(&self, value: &Value, _options: Option<&Value>) -> rustf::Result<()> {
        if value.is_null() {
            return Err(rustf::Error::validation("Value is required"));
        }
        Ok(())
    }

    fn name(&self) -> &str {
        "{{name}}_validator"
    }
}
