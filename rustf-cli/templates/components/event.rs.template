//! {{event_title}} event handlers.
//!
//! Event handlers have signature
//!   `Fn(EventContext) -> Pin<Box<dyn Future<Output = rustf::Result<()>> + Send>>`
//! which means passing a bare `async fn` to `emitter.on(...)` does NOT compile.
//! The correct shape is a closure that wraps the async body in `Box::pin`:
//!
//!     emitter.on("ready", |ctx| Box::pin(on_ready(ctx)));
//!
//! That's the pattern used throughout this file.

use rustf::events::{EventContext, EventEmitter};
use rustf::prelude::*;

pub fn install(emitter: &mut EventEmitter) {
    emitter.on("ready", |ctx| Box::pin(on_ready(ctx)));
{{#if lifecycle}}
    emitter.on("config.loaded", |ctx| Box::pin(on_config_loaded(ctx)));
    emitter.on("database.ready", |ctx| Box::pin(on_database_ready(ctx)));
    emitter.on("modules.ready", |ctx| Box::pin(on_modules_ready(ctx)));
    emitter.on("middleware.ready", |ctx| Box::pin(on_middleware_ready(ctx)));
    emitter.on("routes.ready", |ctx| Box::pin(on_routes_ready(ctx)));
    emitter.on_priority("startup", -100, |ctx| Box::pin(on_startup_early(ctx)));  // runs first
    emitter.on_priority("startup", 100, |ctx| Box::pin(on_startup_late(ctx)));    // runs last
{{/if}}
{{#if custom}}
    emitter.on("{{event_name}}.initialized", |ctx| Box::pin(on_{{event_name}}_initialized(ctx)));
    emitter.on("{{event_name}}.data.received", |ctx| Box::pin(on_data_received(ctx)));
    emitter.on("{{event_name}}.error", |ctx| Box::pin(on_error(ctx)));
    emitter.once("{{event_name}}.first.run", |ctx| Box::pin(on_first_run(ctx)));
{{/if}}
}

/// Application-ready handler.
///
/// Note: `ctx.config`, `ctx.data`, `ctx.event`, `ctx.environment` are all
/// PUBLIC FIELDS on `EventContext`, not methods. Access them directly.
async fn on_ready(ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: application is ready");
    if ctx.is_development() {
        log::info!("  development mode");
    }
    if ctx.is_production() {
        log::info!("  production mode");
    }
    log::info!("  server: {}:{}", ctx.config.server.host, ctx.config.server.port);
    Ok(())
}
{{#if lifecycle}}

async fn on_config_loaded(ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: configuration loaded");
    if ctx.config.server.port == 0 {
        return Err(rustf::Error::internal("invalid port configuration"));
    }
    Ok(())
}

async fn on_database_ready(ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: database connection established");
    if ctx.is_development() {
        // TODO: seed development data here
    }
    Ok(())
}

async fn on_modules_ready(_ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: shared modules initialised");
    Ok(())
}

async fn on_middleware_ready(_ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: middleware chain configured");
    Ok(())
}

async fn on_routes_ready(_ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: routes registered");
    Ok(())
}

async fn on_startup_early(_ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: early startup");
    // Create required directories, warm caches, etc.
    for dir in ["uploads", "logs"] {
        if !std::path::Path::new(dir).exists() {
            std::fs::create_dir_all(dir)?;
        }
    }
    Ok(())
}

async fn on_startup_late(_ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: late startup done");
    Ok(())
}
{{/if}}
{{#if custom}}

async fn on_{{event_name}}_initialized(ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: {{event_name}} initialised");
    if let Some(data) = &ctx.data {
        log::debug!("  initialisation data: {:?}", data);
    }
    Ok(())
}

async fn on_data_received(ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: data received");
    if let Some(data) = &ctx.data {
        log::debug!("  processing data: {:?}", data);
        // emit() is ASYNC — remember .await.
        ctx.emit("{{event_name}}.data.processed", Some(data.clone())).await?;
    }
    Ok(())
}

async fn on_error(ctx: EventContext) -> rustf::Result<()> {
    log::warn!("{{event_title}}: error event");
    if let Some(error_data) = &ctx.data {
        log::warn!("  error details: {:?}", error_data);
    }
    Ok(())
}

async fn on_first_run(_ctx: EventContext) -> rustf::Result<()> {
    log::info!("{{event_title}}: first run — performing one-time setup");
    Ok(())
}
{{/if}}
