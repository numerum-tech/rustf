[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2021"
description = "A RustF web application"
authors = ["Your Name <your.email@example.com>"]

[dependencies]
# Default features include all database drivers and Redis.
rustf = "{{rustf_version}}"
# Lean build — pick only what you need (e.g. PostgreSQL + Redis):
# rustf = { version = "{{rustf_version}}", default-features = false, features = ["db-postgres", "redis", "embedded-views", "schema"] }
# Working on the framework itself? Point at a local checkout instead:
# rustf = { path = "../rustf/rustf" }

# Essential dependencies
tokio = { version = "1.0", features = ["full"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
log = "0.4"
env_logger = "0.10"

# Optional: for database operations
# Trim sqlx features to the driver(s) you actually use.
# Example PostgreSQL-only:
# sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres", "chrono", "rust_decimal", "uuid"] }
# Example MySQL-only:
# sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "mysql", "chrono", "rust_decimal", "uuid"] }
# Example SQLite-only:
# sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "sqlite", "chrono", "rust_decimal", "uuid"] }
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "mysql", "postgres", "sqlite", "chrono", "rust_decimal", "uuid"] }
anyhow = "1.0"
async-trait = "0.1"

# Optional: for date/time handling
chrono = { version = "0.4", features = ["serde"] }
rust_decimal = { version = "1.32", features = ["serde"] }

# Additional dependencies for shared utilities
regex = "1.10"
once_cell = "1.19"
rand = "0.8"
hex = "0.4"
uuid = { version = "1.0", features = ["v4", "serde"] }

# Optional: HTTP client
# reqwest = { version = "0.11", features = ["json"] }
