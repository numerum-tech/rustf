# Rust
/target
**/*.rs.bk
Cargo.lock

# RustF specific
/private/uploads/*
!/private/uploads/.gitkeep
!/private/uploads/README.md
# Runtime database lives under private/data — never track it
/private/data/

# Logs
*.log
/logs

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.production
config.dev.toml
config.prod.toml

# Database
/*.sqlite
/*.db

# Temporary files
/tmp
*.tmp

# Build artifacts
/dist
/build

# Node modules (if using any frontend tools)
node_modules/

# Coverage reports
/coverage

# Backup files
*.bak
*.backup

# RustF framework-owned files: --force backups (project root) and
# auto-discovery generated modules (src/.rustf/). Unanchored so both match.
.rustf/
